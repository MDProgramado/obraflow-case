# ===========================================
# ObraFlow - Production Environment Variables
# ===========================================
# Copie este arquivo para .env.production e preencha os valores
# NUNCA commite o arquivo .env.production com valores reais!

# ===========================================
# Database (PostgreSQL)
# ===========================================
POSTGRES_DB=obraflow
POSTGRES_USER=obraflow
POSTGRES_PASSWORD=your-super-secure-db-password-here-min-32-chars

# ===========================================
# Backend (Spring Boot)
# ===========================================
OBRAFLOW_JWT_SECRET=your-super-secure-jwt-secret-here-min-32-chars-base64-encoded

# ===========================================
# Frontend (Next.js)
# ===========================================
NEXTAUTH_URL=https://your-frontend-domain.com
NEXTAUTH_SECRET=your-super-secure-nextauth-secret-here-min-32-chars
NEXT_PUBLIC_APP_URL=https://your-frontend-domain.com

# ===========================================
# Optional: Monitoring / Observability
# ===========================================
# GRAFANA_PASSWORD=your-grafana-password
# PROMETHEUS_RETENTION=30d

# ===========================================
# Optional: External Services
# ===========================================
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# EMAIL_FROM=noreply@your-domain.com